# ---------------------------------------------------------------------------
# Copy to .env.local for development, and set the same keys in Vercel.
# The site BUILDS AND RUNS with none of these — content falls back to bundled
# data and the form logs leads instead of emailing. Set them to go live.
# ---------------------------------------------------------------------------

# Canonical origin. Wrong value breaks canonical URLs, OG tags and sitemap.
NEXT_PUBLIC_SITE_URL=https://hkbuilder.example

# --- Sanity (Phase 4) ------------------------------------------------------
# Until CONTENT_SOURCE=sanity, content is read from src/lib/content/fallback/.
CONTENT_SOURCE=fallback
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Write token: only needed to persist leads as Sanity documents.
SANITY_WRITE_TOKEN=

# --- Forms (Phase 5) -------------------------------------------------------
# REQUIRED IN PRODUCTION. Signs the anti-bot timestamp. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FORM_SECRET=

# Resend. The sending domain must be DKIM/SPF-verified or Gmail will reject
# the mail — and every lead here goes to Gmail.
RESEND_API_KEY=
LEAD_INBOX=hk7builder@gmail.com
LEAD_FROM=HK Builder <enquiries@hkbuilder.example>

# --- Optional: durable rate limiting ---------------------------------------
# Without these the limiter is in-memory only, which does not survive across
# serverless instances. See src/lib/security/ratelimit.js.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
